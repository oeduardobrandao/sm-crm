# ─────────────────────────────────────────────────────────────────────────────
# Switching between PROD and STAGING (local dev)
# ─────────────────────────────────────────────────────────────────────────────
# Vite's envDir is the repo root, and `--mode staging` overlays `.env.staging`
# on top of `.env`. So:
#   • .env          → PROD   (default — used by `npm run dev`, `dev:hub`, `dev:admin`)
#   • .env.staging  → STAGING overrides (only VITE_SUPABASE_URL/ANON_KEY differ)
#
# Run any app against staging with the `:staging` script variant:
#   npm run dev:staging         # CRM   → staging  (:5173)
#   npm run dev:hub:staging     # Hub   → staging  (:5175)
#   npm run dev:admin:staging   # Admin → staging  (:5177)
# Or all three at once (one terminal, Ctrl+C stops all):
#   npm run dev:all             # CRM + Hub + Admin → prod
#   npm run dev:all:staging     # CRM + Hub + Admin → staging
# Backend (CLI) switching is separate:
#   npm run db:link:staging  /  db:link:prod
#   npm run functions:deploy:staging  /  functions:deploy:prod
# Project refs: prod=skjzpekeqefvlojenfsw  staging=wlyzhyfondykzpsiqsce
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Configuration
# Get these from: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry (optional — omit to disable error tracking)
VITE_SENTRY_DSN=

# PostHog product analytics (optional — leave the key blank to disable).
# Blank is the right value for local dev: analytics.ts no-ops entirely without a key, which
# keeps test runs and localhost clicks out of the shared project. The real key lives in the
# Vercel project settings. Note that Vite inlines these at BUILD time, so changing them on
# Vercel does nothing until the next deployment.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Chatwoot support chat widget (optional — leave the token blank to disable).
# Blank is the right value for local dev: supportChat.ts no-ops entirely without a token, which
# keeps test runs and localhost clicks out of the real support inbox. The token is the website
# token of the Chatwoot "Website" inbox (Settings → Inboxes → Configuration). Self-hosters set
# the base URL to their own instance. Like the PostHog keys, Vite inlines these at BUILD time, so
# changing them on Vercel does nothing until the next deployment.
VITE_CHATWOOT_TOKEN=
VITE_CHATWOOT_BASE_URL=https://app.chatwoot.com

# Estúdio v2 editor origin (optional). The forked OpenPencil editor the CRM embeds in an
# iframe (/estudio/:postId). Dev falls back to http://localhost:1420 (`op-editor` launch
# config / `bun --bun run dev` in the fork); unset in prod = Estúdio page shows
# "unavailable" until cutover wires the deployed editor.
VITE_ESTUDIO_EDITOR_ORIGIN=

# Seed/unseed scripts (scripts/seed-demo.mjs, scripts/unseed-demo.mjs)
SEED_EMAIL=your-test-email@example.com
SEED_PASSWORD=your-test-password

# Edge function secrets — set via `npx supabase secrets set`, NOT loaded from this file.
# Listed here for documentation. Never commit real values.
# Stripe billing (billing-checkout / billing-portal / stripe-webhook)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Loops marketing lifecycle emails (loops-sync-cron)
LOOPS_API_KEY=
# PostHog server-side capture — PROJECT WRITE key, same value as VITE_POSTHOG_KEY
POSTHOG_PROJECT_KEY=
