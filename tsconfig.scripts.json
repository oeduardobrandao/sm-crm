{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/crm/src/*"]
    }
  },
  "include": [
    "scripts/changelog/**/*.ts",
    "scripts/blog/**/*.ts",
    "scripts/stream/**/*.ts",
    "scripts/seo/**/*.ts",
    "scripts/seo/**/*.tsx",
    "scripts/convert-hub-pages-richtext.ts",
    "scripts/__tests__/convert-hub-pages-richtext.test.ts",
    "scripts/__tests__/convert-hub-pages-richtext.db.test.ts",
    "scripts/__tests__/convert-hub-pages-richtext.fallback.test.ts",
    "scripts/__tests__/convert-hub-pages-richtext.connect.test.ts",
    "scripts/__tests__/convert-hub-pages-richtext.restore.test.ts",
    "apps/crm/src/content/**/*.ts",
    "apps/crm/src/content/**/*.tsx",
    "apps/crm/src/pages/politica-privacidade/**/*.tsx",
    "apps/crm/src/pages/termos-de-uso/**/*.tsx",
    "apps/crm/src/pages/lgpd/**/*.tsx"
  ],
  "exclude": ["apps/crm/src/content/blog.client.ts", "apps/crm/src/content/__tests__/**"]
}
